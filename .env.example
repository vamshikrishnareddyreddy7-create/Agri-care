[TEMPLATE]
[TEMPLATE]
# ---- Copy this file to .env and fill in real values. Never commit .env! ----

# Flask session secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=
# (SECRET_KEY is accepted as a legacy alias)
SECRET_KEY=

# Server
FLASK_DEBUG=0
PORT=5000
# External base URL used in email links when behind a proxy (e.g. Render):
APP_BASE_URL=

# Session cookie: set to 1 in production behind HTTPS
SESSION_COOKIE_SECURE=0

# MySQL — leave empty to run in Demo Mode (bundled sample data, no DB required)
# Either a full URL or individual settings:
DATABASE_URL=
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=farm_equipment

# ML model path (leave default; generated by model/train_model.py)
MODEL_PATH=model/predictive_model.pkl

# LLM for the AI chatbot (optional). Without a key the chatbot answers from the
# built-in maintenance knowledge base only.
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# Email / SMTP (optional) — verification, password reset and alert emails.
# With EMAIL_HOST empty the app runs in demo email mode: emails are printed to
# the server log and verification/reset links are surfaced in the UI.
# Gmail example: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USER=<you@gmail.com>,
# EMAIL_PASSWORD=<16-char app password> (https://myaccount.google.com/apppasswords)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=AgriCare <noreply@agricare.local>
EMAIL_USE_TLS=1
# (SMTP_* names are accepted as legacy aliases)

# SMS provider (optional). Supported: twilio | console (console = demo mode,
# SMS printed to the server log). Twilio: SMS_API_KEY = Account SID,
# SMS_API_SECRET = Auth Token, SMS_FROM_NUMBER = your Twilio number.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM_NUMBER=

# Alert thresholds: minimum severity that triggers email / SMS
# (low < medium < high < critical). In-app alerts are always created.
ALERT_EMAIL_MIN_SEVERITY=medium
ALERT_SMS_MIN_SEVERITY=high
# A HIGH-risk prediction with anomaly probability >= this becomes CRITICAL
CRITICAL_PROBABILITY=97

# Verification / OTP security
VERIFY_TOKEN_TTL_HOURS=24
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# --- Google OAuth ("Continue with Google") — optional -----------------------
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID.
# Authorized redirect URI must match exactly: <your-app-url>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override of the callback URL (defaults to <APP_BASE_URL>/auth/google/callback)
GOOGLE_REDIRECT_URI=
# Optional comma-separated email-domain allow-list (empty = any Google account)
GOOGLE_ALLOWED_DOMAINS=
